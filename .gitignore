# ─────────────────────────────────────────────
# .gitignore global — LeBonVoisin
# front/ et back/ ont aussi leur propre .gitignore
# ─────────────────────────────────────────────

# Variables d'environnement / secrets
.env
.env.*
!.env.example

# Systèmes d'exploitation
.DS_Store
Thumbs.db
desktop.ini

# Éditeurs / IDE
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ── Node / Next.js (filet de sécurité) ──
node_modules/
.next/
out/
*.tsbuildinfo
next-env.d.ts

# ── Python (filet de sécurité) ──
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Divers
coverage/
dist/
build/